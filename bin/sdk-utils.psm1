#Requires -Version 5.1
# sdk-utils.psm1 - Development Utilities for Shebang MCP SDK Consumers
#
# This module contains development-time utilities that consumers can import
# into their own scripts. It is NOT part of the core MCP SDK runtime and
# should NOT be bundled with generated consumer MCP servers.
#
# Utilities:
#   sdk-generate-handler <json-schema> [-Language pwsh|bash]  - Generate handler code from tool schema
#
# Usage:
#   Import-Module "${PLUGIN_ROOT}/bin/sdk-utils.psm1"
#   sdk-generate-handler -Schema '{"name":"my_tool",...}' -Language pwsh
#
# Or dot-source generated code:
#   . <(sdk-generate-handler -Schema '{"name":"my_tool",...}' -Language pwsh)

Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

$ScriptDir = Split-Path -Parent $MyInvocation.MyCommand.Path
$PluginRoot = if ($env:PLUGIN_ROOT) { $env:PLUGIN_ROOT } else { (Resolve-Path (Join-Path $ScriptDir "..")).Path }
$env:PLUGIN_ROOT = $PluginRoot

# Source core SDK module for JSON helpers
$SdkModule = Join-Path $PluginRoot 'bin\mcp-sdk.psm1'
if (Test-Path -LiteralPath $SdkModule) {
    Import-Module -LiteralPath $SdkModule -Force -ErrorAction SilentlyContinue
}

# ============================================================================
# SDK-GENERATE-HANDLER: Language-agnostic code generation for MCP consumers
# ============================================================================
# Takes a tool schema (JSON string) and emits PowerShell handler code for
# Handle-ListTools and Handle-ToolsCall that consumers can dot-source into
# their own scripts.
#
# Usage:
#   sdk-generate-handler '<json-schema>' [language]
#   language: pwsh (default) | bash
#
# Example schema:
#   {"name":"my_tool","description":"Does something","parameters":[{"name":"input","type":"string","required":true}]}

function sdk-generate-handler {
    param(
        [Parameter(Mandatory = $true)]
        [string]$Schema,

        [string]$Language = 'pwsh'
    )

    if ([string]::IsNullOrWhiteSpace($Schema)) {
        Write-Error "sdk-generate-handler requires a Schema argument"
        return
    }

    try {
        $schemaObj = $Schema | ConvertFrom-Json -ErrorAction Stop
    } catch {
        Write-Error "Invalid JSON schema provided"
        return
    }

    $toolName = if ($schemaObj.PSObject.Properties['name']) { [string]$schemaObj.name } else { 'my_tool' }
    $toolDesc = if ($schemaObj.PSObject.Properties['description']) { [string]$schemaObj.description } else { 'MCP tool' }
    $params = if ($schemaObj.PSObject.Properties['parameters'] -and $schemaObj.parameters -is [array]) { $schemaObj.parameters } else @()

    # Build parameter extraction code for PowerShell
    $paramDeclare = ""
    $paramExtract = ""
    foreach ($p in $params) {
        $pName = [string]$p.name
        $paramDeclare += "    \$_sgh_p_${pName} = ''`n"
        $paramExtract += "    \$_sgh_p_${pName} = if (\$null -ne \$toolArgs -and \$toolArgs.PSObject.Properties['${pName}']) { [string]\$toolArgs.${pName} } else { '' }`n"
    }

    # PowerShell handler output (default)
    @"
# =============================================================================
# Auto-generated MCP Tool Handler: ${toolName}
# Generated by sdk-generate-handler from tool schema
# Dot-source this file in your consumer script:
#   . <(sdk-generate-handler '{"name":"my_tool",...}' -Language pwsh)
# =============================================================================

function global:Handle-ListTools {
    param(\$Id, [System.Collections.IDictionary]\$Params = @{})
    \$tools = @(
        [ordered]@{
            name        = '${toolName}'
            description = '${toolDesc}'
            inputSchema = [ordered]@{
                type       = 'object'
                properties = [ordered]@{}
                required   = @()
            }
        }
    )
    return json-response -Id \$Id -Result @{ tools = \$tools }
}

function global:Handle-ToolsCall {
    param(\$Id, [System.Collections.IDictionary]\$Params = @{})
    \$toolName = if (\$null -ne \$Params -and \$Params.Contains('name')) { [string]\$Params['name'] } else { '' }
    \$toolArgs = if (\$null -ne \$Params -and \$Params.Contains('arguments') -and \$null -ne \$Params['arguments']) {
        \$Params['arguments'] | ConvertFrom-Json -ErrorAction SilentlyContinue
    } else { @{} }
${paramDeclare}
${paramExtract}

    if (\$toolName -eq '${toolName}') {
        # TODO: Implement tool logic here
        # Access arguments via: \$toolArgs.input
        \$result = [ordered]@{
            content = @(
                [ordered]@{
                    type = 'text'
                    text = 'Tool ${toolName} executed successfully'
                }
            )
            isError = \$false
        }
        return json-response -Id \$Id -Result \$result
    }

    \$err = mcp-error -Code -32601 -Message "Tool not found: \$toolName"
    return json-response -Id \$Id -Error \$err
}
"@ | Write-Output
}

# Alias for snake_case consistency
function sdk_generate_handler {
    param(
        [Parameter(Mandatory = $true)]
        [string]$Schema,
        [string]$Language = 'pwsh'
    )
    sdk-generate-handler -Schema $Schema -Language $Language
}

Export-ModuleMember -Function @(
    'sdk-generate-handler',
    'sdk_generate_handler'
)
